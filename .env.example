# cp .env.example .env 后填写。部署脚本会拒绝占位值。不要提交 .env。
MNEME_API_TOKEN=replace-with-at-least-32-random-characters
MNEME_LLM_API_KEY=replace-with-provider-key
MNEME_NEO4J_PASSWORD=replace-with-a-strong-password
# 可选覆盖 config/default.toml
MNEME_LLM_BASE_URL=https://api.example.com/v1
MNEME_LLM_MODEL=replace-with-provider-model
