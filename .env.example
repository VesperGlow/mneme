# 复制为 .env，填这四项后运行 bash scripts/start.sh；不要提交 .env。
MNEME_LLM_API_KEY=replace-with-provider-key
MNEME_LLM_BASE_URL=https://api.example.com/v1
MNEME_QQ_APP_ID=
MNEME_QQ_APP_SECRET=

# 可选：留空时自动从 /models 选择第一个聊天模型；建议明确指定常用模型。
MNEME_LLM_MODEL=
# 以下两个留空即可，安装时自动生成、写回 .env，并在重装/重启时保留。
MNEME_API_TOKEN=
MNEME_NEO4J_PASSWORD=
MNEME_QQ_SANDBOX=false

# 独立浏览器工具服务，凭证安装时自动生成并保留。
MNEME_TOOLS_ENABLED=true
MNEME_TOOLS_TOKEN=
