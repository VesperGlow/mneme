# 复制为 .env，填这四项后运行 bash scripts/start.sh；不要提交 .env。
MNEME_LLM_API_KEY=replace-with-provider-key
MNEME_LLM_BASE_URL=https://api.example.com/v1
MNEME_QQ_APP_ID=
MNEME_QQ_APP_SECRET=

# 可选：留空时自动从 /models 选择第一个聊天模型；建议明确指定常用模型。
MNEME_LLM_MODEL=
# 所有渠道共享 10 万 token 上下文，每累计新增 1 万字批量提取记忆。
MNEME_LLM_CONTEXT_TOKENS=100000
MNEME_LLM_HISTORY_TURNS=1000
MNEME_MEMORY_EXTRACT_CHARS=10000
# 以下凭证留空即可，安装时自动生成、写回 .env，并在重装/重启时保留。
MNEME_API_TOKEN=
MNEME_NEO4J_PASSWORD=
MNEME_CONSOLE_PASSWORD=
# WebUI 登录有效期；HTTPS 部署时启用 Secure Cookie。
MNEME_CONSOLE_SESSION_DAYS=30
MNEME_CONSOLE_SECURE_COOKIE=false
MNEME_QQ_SANDBOX=false

# 独立浏览器工具服务，凭证安装时自动生成并保留。
MNEME_TOOLS_ENABLED=true
MNEME_TOOLS_TOKEN=
# 每轮最多 200 次工具调用，整轮最多 30 分钟；覆盖旧 config.toml 的限制。
MNEME_TOOLS_MAX_CALLS=200
MNEME_TOOLS_TURN_TIMEOUT_SECONDS=1800
